# AI 交易員：Claude 每小時看前 50 大幣行情與新聞後決策，程式強制停損與風控上限。
# --live：AI 專用子帳戶真倉（停損、止盈掛在交易所）＋ 200 U 模擬盤跟單比較。
# 子帳戶 API key 放 /etc/cryptobot-aitrader/live.env（root 600）：
#   AITRADER_API_KEY=...
#   AITRADER_API_SECRET=...
# 安裝：
#   cp deploy/cryptobot-aitrader.service /etc/systemd/system/ && systemctl daemon-reload
#   systemctl enable --now cryptobot-aitrader
[Unit]
Description=automation-crypto AI trader (AI sub-account + paper mirror)
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=root
WorkingDirectory=/root/automation-crypto
ExecStart=/usr/bin/python3 -m cryptobot ai-trader --live
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=/etc/cryptobot-butler/claude.env
EnvironmentFile=/etc/cryptobot-aitrader/live.env
Restart=on-failure
RestartSec=60
KillSignal=SIGINT
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
