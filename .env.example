# 複製成 .env：cp .env.example .env   (.env 已被 git 忽略，不會上傳)

# --- Binance API key (只有 live 實盤需要) ---
# 權限：勾選「允許合約」，絕對不要勾「允許提領」，並綁定伺服器 IP 白名單
EXCHANGE_API_KEY=
EXCHANGE_API_SECRET=
# 部分交易所(OKX、KuCoin 等)需要
EXCHANGE_API_PASSWORD=

# --- Telegram 通知 ---
# 1. Telegram 搜尋 @BotFather，輸入 /newbot 建立機器人，取得 token
# 2. 對你的機器人隨便傳一則訊息
# 3. 瀏覽器打開 https://api.telegram.org/bot<token>/getUpdates ，找到 "chat":{"id":數字}
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
